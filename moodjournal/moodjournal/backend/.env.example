# Copy to .env for local development only. Never commit real values.
# Keep APP_ENCRYPTION_KEY unchanged when opening an existing database; changing it
# without a planned decrypt/re-encrypt migration makes old encrypted entries unreadable.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
APP_ENCRYPTION_KEY=replace-with-the-existing-database-encryption-key
GOOGLE_API_KEY=
MISTRAL_API_KEY=
SPRING_MAIL_PASSWORD=
APP_EMAIL_ENABLED=false
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
